rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 練習動画・姿勢系列(pose.json): 所有者のみ読み書き可能(#41で導入したパス規約)。
    match /users/{uid}/videos/{videoId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 200 * 1024 * 1024;
    }

    // プロフィールアイコン(#40)。5MB上限。
    match /users/{uid}/icon/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024;
    }

    // 連(ren)アイコン・スタイル参照動画: 連の管理機能が未実装のため、
    // クライアントからの書き込みは一律拒否(将来Admin SDK経由に一本化する想定)。
    match /ren/{renId}/icon/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /ren/{renId}/styleReferences/{fileName} {
      allow read, write: if false;
    }

    // 交流広場への投稿動画(data/community.ts の uploadVideoAndPublish)。
    // users/{uid}/videos/ と同じく、本人ディレクトリ配下にのみ書き込みを許可する。
    // 投稿削除UIが未実装のため削除経路は無い(delete:false)。
    match /videos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 200 * 1024 * 1024;
      allow delete: if false;
    }

    // 上記いずれにも一致しないパスはデフォルト拒否。
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
