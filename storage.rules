rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 練習動画: 所有者のみ読み書き可能(#41で導入したパス規約)。
    // 公開投稿(posts.videoUrl)はCommunityScreenの投稿フローが使う
    // 直下のvideos/を今も使っており、下の包括ルールでカバーする。
    match /users/{uid}/videos/{videoId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 200 * 1024 * 1024;
    }

    // プロフィールアイコン(#40)。5MB上限。contentTypeの検証は、
    // React Native側でアップロード時に正しい値が送られるか実機未検証の
    // ため見送っている(#50と同じ判断)。既に#39で使われているパス。
    match /users/{uid}/icon/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024;
    }

    // 連(ren)アイコン。当初はStorage RulesのCross-Service Rules
    // (firestore.get()でren/{renId}/members/{uid}.roleを直接参照)で
    // 対象連の管理者のみ書き込み可にしようとしたが、本番環境で
    // permission-denied(emulatorでは再現しない)になったため断念し、
    // updateRenIcon(Cloud Functions/Admin SDK、#34)経由に一本化した。
    match /ren/{renId}/icon/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // updateRenIconの一時アップロード領域。本人のみ書き込み可能な
    // 単純なパスにすることで、Cross-Service Rulesの不安定さを回避する。
    match /users/{uid}/renIconUploads/{renId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024;
    }
    match /ren/{renId}/styleReferences/{fileName} {
      allow read, write: if false; // 一般ユーザーには読ませない。system/管理者はAdmin SDK経由
    }

    // CommunityScreenの公開投稿動画。以前は下の包括ルールに依存していた。
    // #34で、その包括ルールが上記すべての制限付きルール(所有者のみ・
    // admin限定・styleReferencesのif false)を無効化していることが
    // 判明したため、この専用ルールを新設し、包括ルールをデフォルト拒否に
    // 差し替えた。削除経路は現状無い(投稿削除UI自体が未実装)ため拒否する。
    match /videos/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                    && request.resource.size < 200 * 1024 * 1024;
      allow delete: if false;
    }

    // 上記いずれにも一致しないパスはデフォルト拒否(#34以前は包括的に
    // 許可しており、他の全ての制限付きルールを事実上無効化していた)。
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}