rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // videos: 練習動画(非公開がデフォルト)。所有者のみ読み書き可能。
    // publishPost実行後(visibility=='public')は他ユーザーも閲覧可能。
    match /videos/{videoId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || resource.data.visibility == 'public');
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // posts: 交流広場に公開された投稿
    match /posts/{postId} {
      allow read: if request.auth != null;
      // 作成はpublishPost(Cloud Functions/Admin SDK)経由のみ。
      // Admin SDKはRulesを経由しないため、クライアントからは常に拒否する。
      allow create: if false;
      // 投稿者本人は全フィールド更新可。他の認証済みユーザーは
      // いいね・コメント機能によるカウンタ更新のみ許可。
      allow update: if request.auth != null
                    && (resource.data.userId == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['likeCount', 'commentCount']));
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.type in ['instructor', 'normal'];
        allow update, delete: if false;
      }

      // likes: ユーザーID をドキュメントIDにすることで二重いいねを防止
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.userId == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // Users: プロフィール。本人のみ読み書き可能。
    // 💡 #39でコレクション名をlowercaseのusersに統一する予定。
    match /Users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // chats: チャットIDが "小さいUID_大きいUID" の形式であることを前提に、
    // 当事者2人のみ読み書き可能とする。
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid in chatId.split('_');
      allow create: if request.auth != null
                    && request.auth.uid in chatId.split('_')
                    && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
