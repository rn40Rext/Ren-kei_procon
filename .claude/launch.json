{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Ren-kei_procon",
        "run",
        "web"
      ],
      "port": 8081
    },
    {
      "name": "expo-web-emulator",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true npm --prefix Ren-kei_procon run web"
      ],
      "port": 8081
    },
    {
      "name": "firebase-emulators",
      "runtimeExecutable": "firebase",
      "runtimeArgs": [
        "emulators:start",
        "--only",
        "auth,firestore,storage,functions",
        "--project",
        "demo-renkei"
      ],
      "port": 4000
    }
  ]
}
