rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ヘルパー(#40で追加) ----------
    function isSignedIn() {
      return request.auth != null;
    }
    // 対象連の管理者か(users.roleではなくren/members側のroleで判定する。仕様書10.3)。
    function isRenAdmin(renId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/ren/$(renId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/ren/$(renId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // videos: 練習動画(非公開がデフォルト)。所有者のみ読み書き可能。
    // publishPost実行後(visibility=='public')は他ユーザーも閲覧可能。
    match /videos/{videoId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || resource.data.visibility == 'public');
      // 作成時はvisibility=private・analysisStatus=uploaded固定。
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.visibility == 'private'
                    && request.resource.data.analysisStatus == 'uploaded';
      // visibility/analysisStatusはクライアントから変更不可
      // (publishPost/FN-01はAdmin SDK経由でRulesを通らないため別枠)。
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['userId', 'visibility', 'analysisStatus']);
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // posts: 交流広場に公開された投稿
    match /posts/{postId} {
      allow read: if request.auth != null;
      // 作成はpublishPost(Cloud Functions/Admin SDK)経由のみ。
      // Admin SDKはRulesを経由しないため、クライアントからは常に拒否する。
      allow create: if false;
      // 投稿者本人のみ更新可。likeCount/commentCountは#48のCloud
      // Functionsトリガ(count()集計、Admin SDK経由でRulesを通らない)
      // のみが更新するため、投稿者本人でもクライアントからは変更不可。
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['userId', 'likeCount', 'commentCount']);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.type in ['instructor', 'normal'];
        // 権限は「投稿者」ではなく「コメント自身のuserId」で判定する(仕様書10.3)。
        // 削除・編集UIは未実装だが、Rules上は本人のみ許可しておく。
        allow update, delete: if request.auth != null
                      && resource.data.userId == request.auth.uid;
      }

      // likes: ユーザーID をドキュメントIDにすることで二重いいねを防止
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.userId == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // users: プロフィール。本人のみ読み書き可能。
    // roleは自己昇格防止のため、createではroleが'user'固定、
    // updateではrole/uid/createdAtが変更差分に含まれないことを検証する
    // (仕様書10.3)。
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'user';
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role', 'uid', 'createdAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // chats: チャットIDが "小さいUID_大きいUID" の形式であることを前提に、
    // 当事者2人のみ読み書き可能とする。
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid in chatId.split('_');
      allow create: if request.auth != null
                    && request.auth.uid in chatId.split('_')
                    && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- #40で追加(以下はまだ書き込むアプリ機能が無いため休眠中) ----------

    // analysisResults / styleAnalysisResults: スコアはsystem(Cloud Functions/
    // Admin SDK)のみが書く。クライアントは直接書き込めない(仕様書10.3)。
    match /analysisResults/{analysisId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /styleAnalysisResults/{styleAnalysisId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{uid}/growthRecords/{recordId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if false;
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ren: 作成はcreateRen(Cloud Functions/Admin SDK)経由のみ。
    // ren本体とmembers(作成者をadminにする)を1つのトランザクションで
    // 書き込むため、クライアントからの直接createは常に拒否する(#26)。
    match /ren/{renId} {
      allow read: if isSignedIn();
      allow create: if false;
      allow update: if isRenAdmin(renId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['createdBy', 'memberCount', 'createdAt']);
      allow delete: if isRenAdmin(renId);

      match /members/{uid} {
        allow read: if isSignedIn();
        allow create: if false; // createRen(作成者登録)・FN-05(参加承認)経由。Admin SDKはRulesを通らない
        allow update: if isRenAdmin(renId);
        allow delete: if isRenAdmin(renId) || (isSignedIn() && request.auth.uid == uid); // 本人の脱退は許可
      }
      match /announcements/{announcementId} {
        allow read: if isSignedIn();
        allow write: if isRenAdmin(renId);
      }
      match /activities/{activityId} {
        allow read: if isSignedIn();
        allow write: if isRenAdmin(renId);
      }
    }

    // joinRequests: 申請者は取消のみ、連管理者は承認・却下のみ(状態遷移を検証)。
    match /joinRequests/{requestId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isRenAdmin(resource.data.renId));
      // 作成はsubmitJoinRequest(Cloud Functions/Admin SDK)経由のみ。
      // 重複pending申請・既存メンバーの再申請チェックは複数ドキュメント
      // にまたがるためRulesでは表現できず、関数側で検証する(#27)。
      allow create: if false;
      allow update: if isSignedIn()
                    && ((resource.data.userId == request.auth.uid
                          && resource.data.status == 'pending'
                          && request.resource.data.status == 'cancelled')
                        || (isRenAdmin(resource.data.renId)
                              && resource.data.status == 'pending'
                              && request.resource.data.status in ['approved', 'rejected']));
      allow delete: if false;
    }

    // renStyle*: 連スタイル類似度まわり。参照動画の登録・閲覧は連管理者のみ。
    // renId はドキュメントのフィールドなので、createではresourceが無くresource.data
    // を参照できない。request.resource側で判定する(create/update以降で分ける)。
    match /renStyleReferences/{referenceId} {
      allow read: if isSignedIn() && isRenAdmin(resource.data.renId);
      allow create: if isSignedIn() && isRenAdmin(request.resource.data.renId);
      allow update, delete: if isSignedIn() && isRenAdmin(resource.data.renId);
    }
    match /renStyleProfiles/{renId} {
      allow read: if isSignedIn();
      allow write: if false; // FN-07(system)のみ
    }

    // analysisRules: 判定閾値のマスタ。運用者がコンソール/Functionsから更新する想定。
    match /analysisRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
