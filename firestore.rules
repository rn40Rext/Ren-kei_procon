rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // videos: 練習動画(非公開がデフォルト)。所有者のみ読み書き可能。
    // publishPost実行後(visibility=='public')は他ユーザーも閲覧可能。
    match /videos/{videoId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || resource.data.visibility == 'public');
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // posts: 交流広場に公開された投稿
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      // 投稿者本人は全フィールド更新可。他の認証済みユーザーは
      // いいね・コメント機能によるカウンタ更新のみ許可。
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['likeCount', 'commentCount']));
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.type in ['instructor', 'normal'];
        allow update, delete: if false;
      }

      // likes: ユーザーID をドキュメントIDにすることで二重いいねを防止
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }
  }
}
